# GenAI Career Assistant 配置模板
# 用法：复制为 .env 后填入真实值，重启服务生效。
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
# 说明：config.py 已用 load_dotenv(override=True)，本文件取值会覆盖同名系统环境变量。

# ---------- 对话大模型（必填）----------
# 示例为阿里云百炼 OpenAI 兼容端点；可用 DeepSeek / OpenAI / 通义等任意兼容服务。
# 百炼申请地址：https://dashscope.console.aliyun.com/
OPENAI_API_KEY=<你的对话模型Key>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus-2025-07-28

# ---------- Embedding（建知识库 / 向量检索需要；留空则自动复用上方 OPENAI_API_KEY）----------
# 注意：复用需确保上方 Key 同源；例如百炼 Key 配百炼 Embedding，否则建库会失败。
EMBEDDING_API_KEY=<你的Embedding模型Key，可留空复用OPENAI_API_KEY>
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ---------- 重排（默认走 LLM 重排，可留空复用上方 Key）----------
RERANK_API_KEY=<你的重排Key，可留空复用EMBEDDING_API_KEY>
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 可选开关 ----------
# 联网搜索：无外网时设 false（避免每次请求空等超时，模型改用自身知识回答）；有外网设 true。
ENABLE_WEB_SEARCH=false
# Function Calling（自主工具调用）：默认关闭，走「显式检索」路径（行为与历史版本逐字节一致）。
# 打开后，被标记 needs_tools 的场景（如 job_search）改由模型自主决定是否/如何调用工具，
# 工具调用过程会通过 SSE tool_call 事件透出到两个前端。两条路径可 A/B 对比（见 README §四）。
ENABLE_TOOL_CALLING=false
# 工具调用轮次上限：达到即强制收束为自然语言作答，避免多轮往返把延迟与成本拖失控。
TOOL_CALLING_MAX_STEPS=3
# USE_BM25=true
# USE_VECTOR=true
# FUSION=rrf
# TOP_K=5

# 人机协同：高风险场景（简历 / 模拟面试 / 职位清单）或命中高风险话题（薪资谈判 / 离职仲裁 /
# 背调 / 个人隐私）时，产物先落「草稿」并提示人工审阅，确认后才定稿，避免全自动外发。
# 设 false 可恢复为全自动直接定稿（便于对比演示）。
ENABLE_HUMAN_CONFIRM=true

# ---------- API 安全（可选）----------
# 填入后，所有 /chat /knowledge /sessions 业务接口须携带请求头 X-API-Key；留空则关闭鉴权（兼容演示）。
API_KEY=
# 每客户端 IP 每分钟请求上限；设为 0 可关闭限流。
API_RATE_LIMIT=60

# ---------- OpenTelemetry 链路追踪（可选，留空即关闭）----------
# 设置后自动导出 span 到 OTLP 后端（Jaeger / Tempo / 阿里云 ARMS 等），需先 pip install -r requirements-otel.txt
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=genai-career-assistant

# ---------- 生产级补强（终止兜底 / 失败分级 / 数据时效 / 可恢复性 / 熔断与指标）----------
# 图级递归上限：与 TOOL_CALLING_MAX_STEPS 是两层保护（轮次上限管 ReAct 往返，这一层管整图超步）。
TOOL_RECURSION_LIMIT=25

# 联网检索失败分级：同通道重试次数 / 退避秒数 / 备选通道（DuckDuckGo backend）/ 检索式简化长度。
# 策略顺序：重试 → 换参数（简化检索式）→ 换通道 → 如实降级（不编造结果）。
WEB_SEARCH_RETRY_ATTEMPTS=2
WEB_SEARCH_RETRY_BACKOFF=0.5
WEB_SEARCH_ALT_BACKEND=text
WEB_SEARCH_SIMPLIFY_CHARS=60

# 数据时效：工具结果注入抓取时间（模型没有时钟，资料时间只能由工具如实告知）。
ENABLE_FETCH_TIME=true

# 工具熔断：连续失败到阈值后，冷却期内直接短路。
# 重试解决「单次抖动」，熔断解决「上游整体挂掉」——后者继续重试只是成倍增加等待。
ENABLE_TOOL_CIRCUIT_BREAKER=true
TOOL_BREAKER_THRESHOLD=3
TOOL_BREAKER_COOLDOWN=60

# 可恢复性：会话级恢复（从 SQLite 重建历史）+ 图级 checkpoint（sqlite → memory → 不启用，自动降级）。
# 装了 langgraph-checkpoint-sqlite 才是跨进程的；否则退化为进程内（重试同轮不重复执行工具）。
ENABLE_SESSION_RESUME=true
ENABLE_CHECKPOINT=true
# CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# 槽位记忆：把「目标城市 / 岗位方向 / 时间范围 / 学历」单独记住并每轮重注入。
# 默认关闭——它会改变提示词组装，先关着用 A/B 证明收益再打开（与 ENABLE_TOOL_CALLING 同一套态度）。
ENABLE_SLOT_MEMORY=false
