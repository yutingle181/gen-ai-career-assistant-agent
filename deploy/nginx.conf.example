# nginx 反向代理模板（把 SERVER_NAME 与证书路径改掉再用）
#
# 关键点（都是踩过的坑）：
#   1. **长连接要放开**：/chat/stream 是 SSE，proxy_buffering 默认开启会把响应攒住，
#      表现为前端"转圈很久然后一次性全出来"。必须 proxy_buffering off + 读超时放大。
#   2. **X-Forwarded-* 必须透传**：应用的 IP 限流（API_RATE_LIMIT）按 request.client.host 算，
#      不透传的话所有请求都算在 nginx 的 IP 上 → 全站共用一个额度，一个人用完所有人被限。
#   3. 探活指向 /healthz 而不是 /health：/health 会真调模型，超时会触发 nginx 报错，
#      用它做上游判活等于把「模型慢」升级成「服务不可用」。
#   4. 未备案时只能用 <IP>:8000 直连明文；备案后再上 80/443 + Let's Encrypt。

upstream genai_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

upstream genai_web {
    server 127.0.0.1:8501;
}

# ---------- API ----------
server {
    listen 80;
    server_name SERVER_NAME;      # 未备案时填公网 IP，或直接删掉这个 server 块

    client_max_body_size 32m;      # 知识库 ingest 上传文档用得到

    location / {
        proxy_pass http://genai_api;
        proxy_http_version 1.1;

        # 透传客户端真实 IP：应用侧限流与日志都依赖它
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE（/chat/stream）：不缓冲 + 长读超时，否则流式退化成"一次性全出来"
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        chunked_transfer_encoding off;
    }
}

# ---------- Streamlit 界面 ----------
server {
    listen 80;
    server_name SERVER_NAME;

    location / {
        proxy_pass http://genai_web;
        proxy_http_version 1.1;

        # Streamlit 用 WebSocket 推 UI 更新，不透传 upgrade 就会一直转圈
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 600s;
        proxy_buffering off;
    }
}

